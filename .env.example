# --- App ---
APP_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=
# First administrator; this address is promoted on first sign-in.
ADMIN_EMAIL=you@example.com
# Docker Compose overrides both paths to the /data volume.
DATABASE_PATH=./data/ambagan.db
# Uploaded payment QR images. Keep on persistent storage (a volume in Docker).
ASSETS_DIR=./data/assets

# Daily backups: where they go and how many to keep. The default folder is next to the database; point
# BACKUP_DIR at a host folder you copy off the machine (see docs/backup-restore.md).
# BACKUP_DIR=/backups
BACKUP_KEEP=14

# Optional: where people write about their personal data (shown on /privacy). Default shown.
# PRIVACY_EMAIL=ambagan.privacy@thekovie.com

# --- SMTP (required in production; dev falls back to console-logged links) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Shared Subscription Payments"
SMTP_FROM_EMAIL=your-email@example.com
SMTP_REPLY_TO=your-email@example.com
